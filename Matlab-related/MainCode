clc;
clear;
close all;

%% =========================================================
% D-SHIELD : Adaptive Swarm Detection Simulation
% Distributed Swarm Hardware for Intelligent Electronic
% Layered Defense
%% =========================================================

%% Grid Parameters
grid_size = 250;

%% Number of Enemy Drones
num_drones = 5;

%% Drone Names
drone_names = {
    'Alpha';
    'Beta';
    'Gamma';
    'Etta';
    'Phi'
};

%% Simulation Parameters
time_steps = 200;
pause_time = 0.05;

%% Detection Radius
detection_radius = 45;

%% =========================================================
% Defense Node Positions
%% =========================================================

nodes = [
    60 60;
    125 180;
    190 70
];

%% Defense Node Names

node_names = {
    'Garuda';
    'Maruti';
    'Narasimha'
};

num_nodes = size(nodes,1);

%% =========================================================
% Enemy Drone Initialization
%% =========================================================

% Random Initial Positions
drone_pos = rand(num_drones,2) * grid_size;

% Random Velocities
drone_vel = (rand(num_drones,2) - 0.5) * 4;

%% =========================================================
% Figure Setup
%% =========================================================

figure('Color','w');

%% =========================================================
% Main Simulation Loop
%% =========================================================

for t = 1:time_steps
    
    clf;
    hold on;
    
    axis([0 grid_size 0 grid_size]);
    grid on;
    
    title(['D-SHIELD Adaptive Swarm Detection | Time Step = ', num2str(t)]);
    
    xlabel('X Position');
    ylabel('Y Position');
    
    %% =====================================================
    % Protected Zone
    %% =====================================================
    
    rectangle('Position',[90 90 70 70],...
        'EdgeColor','r',...
        'LineWidth',2,...
        'LineStyle','--');
    
    text(100,165,'Protected Zone',...
        'Color','r',...
        'FontWeight','bold',...
        'FontSize',11);
    
    %% =====================================================
    % Plot Defense Nodes
    %% =====================================================
    
    theta_spiral = linspace(0,6*pi,500);
    
    for n = 1:num_nodes
        
        node_x = nodes(n,1);
        node_y = nodes(n,2);
        
        %% Plot Node
        
        plot(node_x,node_y,'bs',...
            'MarkerSize',12,...
            'MarkerFaceColor','b');
        
        %% Node Name
        
        text(node_x+3,node_y+3,...
            node_names{n},...
            'FontWeight','bold',...
            'Color','b');
        
        %% =================================================
        % Spiral Detection Pattern
        %% =================================================
        
        r = linspace(0,detection_radius,500);
        
        spiral_x = node_x + r .* cos(theta_spiral);
        spiral_y = node_y + r .* sin(theta_spiral);
        
        plot(spiral_x,spiral_y,...
            'c',...
            'LineWidth',1.2);
        
        %% =================================================
        % Outer Detection Boundary
        %% =================================================
        
        theta_circle = linspace(0,2*pi,300);
        
        circle_x = node_x + detection_radius*cos(theta_circle);
        circle_y = node_y + detection_radius*sin(theta_circle);
        
        plot(circle_x,circle_y,...
            'b:',...
            'LineWidth',1.2);
    end
    
    %% =====================================================
    % Update Drone Positions
    %% =====================================================
    
    drone_pos = drone_pos + drone_vel;
    
    %% =====================================================
    % Boundary Reflection
    %% =====================================================
    
    for d = 1:num_drones
        
        if drone_pos(d,1) <= 0 || drone_pos(d,1) >= grid_size
            drone_vel(d,1) = -drone_vel(d,1);
        end
        
        if drone_pos(d,2) <= 0 || drone_pos(d,2) >= grid_size
            drone_vel(d,2) = -drone_vel(d,2);
        end
    end
    
    %% =====================================================
    % Plot Drones
    %% =====================================================
    
    for d = 1:num_drones
        
        x = drone_pos(d,1);
        y = drone_pos(d,2);
        
        %% =================================================
        % Threat Score Calculation
        %% =================================================
        
        min_distance = inf;
        
        for n = 1:num_nodes
            
            node_x = nodes(n,1);
            node_y = nodes(n,2);
            
            distance = sqrt((x-node_x)^2 + (y-node_y)^2);
            
            if distance < min_distance
                min_distance = distance;
            end
        end
        
        %% Drone Speed
        
        speed = sqrt(drone_vel(d,1)^2 + drone_vel(d,2)^2);
        
        %% Threat Score
        
        threat_score = speed / (min_distance + 1);
        
        %% =================================================
        % Threat Classification
        %% =================================================
        
        if min_distance < 25
            
            threat_level = 'HIGH';
            drone_color = 'r';
            
        elseif min_distance < 60
            
            threat_level = 'MEDIUM';
            drone_color = 'y';
            
        else
            
            threat_level = 'LOW';
            drone_color = 'g';
        end
        
        %% =================================================
        % Plot Drone with Dynamic Threat Color
        %% =================================================
        
        plot(x,y,'o',...
            'MarkerSize',12,...
            'MarkerFaceColor',drone_color,...
            'MarkerEdgeColor','k',...
            'LineWidth',1.5);
        
        %% Drone Name
        
        text(x+2,y+2,...
            [drone_names{d},' (',threat_level,')'],...
            'Color',drone_color,...
            'FontWeight','bold');
        
        %% =================================================
        % Detection Check
        %% =================================================
        
        for n = 1:num_nodes
            
            node_x = nodes(n,1);
            node_y = nodes(n,2);
            
            distance = sqrt((x-node_x)^2 + (y-node_y)^2);
            
            %% Drone Detected
            
            if distance < detection_radius
                
                %% Detection Line
                
                plot([x node_x],[y node_y],...
                    'm--',...
                    'LineWidth',1.5);
                
                %% Alert Message
                
                disp(['ALERT : ',drone_names{d},...
                    ' | Threat = ',threat_level,...
                    ' | Detected by ',node_names{n},...
                    ' | Time Step = ',num2str(t)]);
                
                %% Highlight Drone
                
                plot(x,y,'mo',...
                    'MarkerSize',16,...
                    'LineWidth',2);
            end
        end
    end
    
    %% =====================================================
    % Threat Level Legend
    %% =====================================================
    
    text(10,240,'LOW Threat = Green',...
        'Color','g',...
        'FontWeight','bold');
    
    text(10,230,'MEDIUM Threat = Yellow',...
        'Color',[0.8 0.6 0],...
        'FontWeight','bold');
    
    text(10,220,'HIGH Threat = Red',...
        'Color','r',...
        'FontWeight','bold');
    pause(pause_time);
end
